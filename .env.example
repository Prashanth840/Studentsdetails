DB_USER=postgres
DB_PASSWORD=password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=prashanth
DB_SSLMODE=disable

# Host-side port the postgres container is published on (container-internal port stays 5432).
# Defaults to 5433 to avoid clashing with a Postgres install already running on the host.
DB_HOST_PORT=5433

# Host-side port + the app's own listen port (both use this value).
APP_PORT=9001
